@startuml
left to right direction
skinparam packageStyle rectangle

actor "Configuratore" as Admin
actor "Fruitore" as User
actor "Sistema (Cron)" as System

rectangle "Applicazione Proposte - Versione 4" {
    package "Configuratore Actions" {
      usecase "Ritira Proposta\n(Aperta o Confermata)" as UC1
    }
    
    package "Fruitore Actions" {
      usecase "Ritiro Iscrizione\n(Disiscrizione in tempo utile)" as UC2
      usecase "Re-Iscrizione" as UC3
    }

    package "System Actions" {
      usecase "Congelamento Partecipanti" as UC4
      usecase "Notifica Automatica Ritiro" as UC5
    }
}

Admin --> UC1
User --> UC2
User --> UC3

System --> UC4
System --> UC5
UC1 .> UC5 : <<include>>
UC1 .> UC4 : <<include>>

@enduml
